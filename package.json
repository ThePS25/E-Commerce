{
  "name": "e-commerce",
  "version": "1.0.0",
  "description": "ZooPHii MERN E-Commerce — Express API + React (client-2)",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client2:dev": "npm run dev --prefix client-2",
    "client2:build": "npm run build --prefix client-2",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run server\" \"npm run client2:dev\"",
    "build": "npm run client2:build",
    "postinstall": "npm install --prefix client-2",
    "heroku-postbuild": "npm run build",
    "start:prod": "cross-env NODE_ENV=production node server.js"
  },
  "keywords": [
    "ecommerce",
    "mern",
    "zoophii"
  ],
  "author": "Pratyush",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.0",
    "braintree": "^3.16.0",
    "colors": "^1.4.0",
    "concurrently": "^8.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-formidable": "^1.2.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.0",
    "moment": "^2.29.4",
    "mongoose": "^7.2.1",
    "morgan": "^1.10.0",
    "nodemon": "^2.0.22",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}
