# Server
NODE_ENV=development
PORT=8080

# Auth — use a long random string in production
JWT_SECRET=replace_me_with_a_long_random_string

# Database (MongoDB Atlas recommended for production)
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/zoophii?retryWrites=true&w=majority

# Braintree Payment Gateway
BRAINTREE_MERCHANT_ID=replace_me
BRAINTREE_PUBLIC_KEY=replace_me
BRAINTREE_PRIVATE_KEY=replace_me

# CORS — comma-separated allowed origins (production)
# Leave empty when frontend is served from same origin (default setup)
CORS_ORIGIN=

# Public URL of your deployed app (optional, used for CORS in production)
CLIENT_URL=https://your-app.onrender.com
