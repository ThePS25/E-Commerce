# Backend API base URL (includes /api/v1 prefix)
# Development: use relative path with Vite proxy, or full URL
VITE_API_URL=/api/v1

# Alternative — direct backend URL (no proxy):
# VITE_API_URL=http://localhost:8080/api/v1

# Note: If your backend runs on port 5000, use:
# VITE_API_URL=http://localhost:5000/api/v1
